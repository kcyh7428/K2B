{
  "profiles": {
    "ai": {
      "enabled": true,
      "group_env_var": "MIHOMO_OPENAI_GROUP",
      "selector_regex": "^♻️ 手动切换[1-9][0-9]*\\Z",
      "exclude_hk": true,
      "exclude_leaf_regex": "^(🌏自动最优线路|🇲🇾 K2B-VPS-KL\\Z|🇹🇼 K2B-VPS-TW\\Z)",
      "targets": [
        "https://chatgpt.com/",
        "https://claude.ai/",
        "https://aistudio.google.com/",
        "https://notebooklm.google.com/",
        "https://generativelanguage.googleapis.com/"
      ],
      "sentinel": "~/.k2b-router-leafopt-enabled",
      "state_file": "~/Library/Application Support/k2b-router-watchdog/leaf-optimizer-state.json",
      "lock_file": "~/Library/Application Support/k2b-router-watchdog/leaf-optimizer.lock",
      "mutation_lock_file": "~/Library/Application Support/k2b-router-watchdog/mihomo-mutation.lock",
      "decision_log": "~/Library/Logs/k2b-router-watchdog/leaf-optimizer.jsonl"
    }
  }
}
