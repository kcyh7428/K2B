<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.k2b.router-private-vpn-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__APP_DIR__/bin/private-vpn-watchdog.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <!-- Keep throttle aligned with StartInterval: this job is the 60-second
       private-path probe. The script-level incident threshold gates
       expensive AWS/SSH tracing, while the cheap Mihomo checks must keep
       running once per minute during router/VPN outages. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin</string>
    <key>K2B_ROUTER_WATCHDOG_APP_DIR</key>
    <string>__APP_DIR__</string>
    <key>K2B_ROUTER_WATCHDOG_LOG_DIR</key>
    <string>__LOG_DIR__</string>
    <key>K2B_ROUTER_WATCHDOG_ENV_FILE</key>
    <string>__ENV_FILE__</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/launchd-private-vpn-watchdog.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchd-private-vpn-watchdog.err.log</string>
</dict>
</plist>
