# Secrets
.env
*.env
youtube-cookies.txt
*youtube*cookie*.txt
*youtube*cookies*.txt
www_youtube_com_cookies*.json
*youtube*cookie*.json
*youtube*cookies*.json

# Dependencies
node_modules/

# Build output
dist/

# Runtime data
store/
*.log
*.pid
k2b-remote/tasks.db
k2b-remote/*.db

# Deferred-sync mailbox (local to each machine, never committed)
# One file per /ship --defer, consumed and deleted by /sync.
/.pending-sync/
# Legacy single-file marker, kept ignored for backward compatibility
/.pending-sync.json

# Temp media
workspace/uploads/

# Autoresearch iteration logs (per-skill, not committed)
**/eval/results.tsv

# Allhands presentation (side project, not K2B)
allhands/
docs/superpowers/specs/2026-03-30-allhands-presentation-design.md

# Side scripts (not K2B)
scripts/generate-org-chart.py

# MiniMax adversarial review artifacts (per-machine, not committed)
.minimax-reviews/

# Unified review runner archives (per-machine, not committed)
/.code-reviews/

# Claude Code plan artifacts
.claude/plans/

# Scheduler runtime lock (orphaned if a scheduler session dies uncleanly)
.claude/scheduled_tasks.lock

# superpowers:using-git-worktrees stub dir (created empty by the skill).
# Left untracked, it crashes Codex's `read()` walk with EISDIR and forces
# scripts/review.sh to fall back to MiniMax on every commit.
.claude/worktrees/

# Per-machine Claude Code local settings (anywhere in tree). Same EISDIR
# hazard as above when the `.claude/` dir it lives in has no tracked files.
**/settings.local.json

# Sub-project Claude Code dirs. Only the repo-root .claude/ has tracked
# content (skills, settings, plans). Sub-projects keep their own local
# config that isn't shared -- ignoring the whole dir avoids the "parent
# has no tracked files" EISDIR hazard.
/k2b-remote/.claude/
/k2b-dashboard/.claude/

# Editor config. Same EISDIR hazard as .claude/worktrees/ above: an untracked
# .vscode/ directory crashes Codex's read() walk and forces scripts/review.sh
# to fall back to MiniMax on every /ship.
.vscode/

# Python bytecode cache
__pycache__/
*.pyc

# Per-machine Python venvs (Washing Machine MacBook + Mini both use this
# path; the Mini's venv is created by scripts/washing-machine/preflight.sh
# and the MacBook's by its equivalent setup. ~700MB of torch deps, never
# committed).
/venv/

# OS files
.DS_Store
k2b-dashboard/.env
k2b-dashboard/node_modules/
k2b-dashboard/dist/

# pytest transient cache
.pytest_cache/
plans/Parked/
plans/Shipped/

# Isolated implementation worktrees created by Codex/Superpowers.
/.worktrees/

# Kimi handoff job specs (local only)
.kimi/

# Codex runtime artifacts are local-only, but the stable instruction surfaces
# are versioned so clean clones and Mini sync get the same Codex context.
.codex/**
!.codex/
!.codex/.gitkeep
!.codex/hooks.json
.agents/*
!.agents/
!.agents/skills/
!.agents/skills/*/
.agents/skills/*/**
!.agents/skills/*/SKILL.md
!.agents/skills/*/resource.md
!.agents/skills/*/eval/
.agents/skills/*/eval/**
!.agents/skills/*/eval/eval.json
!.agents/skills/*/eval/learnings.md
!.agents/skills/*/eval/cases/
!.agents/skills/*/eval/cases/**
!.agents/skills/*/references/
!.agents/skills/*/references/**
!.agents/skills/*/scripts/
!.agents/skills/*/scripts/**
!.agents/skills/*/tests/
!.agents/skills/*/tests/**
.agents/skills/*/eval/cache/**
.agents/skills/*/eval/tmp/**
.agents/skills/*/eval/.cache/**
.agents/skills/*/cache/**
.agents/skills/*/tmp/**
.agents/skills/*/.cache/**
