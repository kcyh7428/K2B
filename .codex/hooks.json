{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
            {
              "type": "command",
              "command": "export PATH=\"/opt/homebrew/opt/node@24/bin:/opt/homebrew/opt/python@3.12/libexec/bin:/opt/homebrew/bin:$PATH\"; export K2B_HOOK_PROVIDER=codex; export K2B_PROJECT_ROOT=\"${K2B_PROJECT_ROOT:-$HOME/Projects/K2B}\"; export K2B_VAULT_PATH=\"${K2B_VAULT_PATH:-$HOME/Projects/K2B-Vault}\"; \"$K2B_PROJECT_ROOT/scripts/hooks/session-start.sh\"",
              "timeout": 10
            }
        ]
      }
    ]
  }
}
